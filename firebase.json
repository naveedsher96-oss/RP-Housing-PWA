{
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "README",
      ".git/**",
      ".gitignore",
      ".nojekyll",
      "**/node_modules/**",
      "functions/**",
      ".agents/**",
      "tests/**",
      ".github/**"
    ],
    "headers": [
      { "source": "/.well-known/assetlinks.json", "headers": [ { "key": "Content-Type", "value": "application/json" } ] },
      { "source": "**/*.@(html|js|json)", "headers": [ { "key": "Cache-Control", "value": "no-cache" } ] }
    ]
  }
}
