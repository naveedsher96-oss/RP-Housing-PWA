rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() {
      return request.auth != null;
    }
    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    // Missing fields raise an error in rules (which fails the whole rule),
    // so every profile field is read via get() with a default.
    function isAdmin() {
      return signedIn() && me().get('role', '') == 'admin';
    }
    function isSuperAdmin() {
      return signedIn() && (me().get('role', '') == 'superadmin' || me().get('superAdmin', false) == true);
    }
    function isBoard() {
      return signedIn() && (me().get('role', '') == 'board' || me().get('boardMember', false) == true);
    }
    function isStaff() {
      return signedIn() && me().get('role', '') in ['admin', 'board', 'superadmin'];
    }
    function isApprovedResident() {
      return signedIn()
        && me().get('role', '') == 'resident'
        && me().get('approved', false) == true
        && me().get('suspended', false) != true;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    // Announcements & polls: admin, superadmin and board members publish;
    // admin/superadmin manage any post, board members only their own.
    function canPublish() {
      return isAdmin() || isSuperAdmin() || isBoard();
    }
    function ownsPost() {
      return isBoard() && resource.data.get('createdBy', '') == request.auth.uid;
    }
    // Only these fields change in this update.
    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }
    // Super Admin may restore archived bills, funds, complaints and expenses
    // (the Restore button in Audit & Archive) but change nothing else.
    function superAdminRestore() {
      return isSuperAdmin()
        && onlyChanges(['isDeleted', 'restoredAt', 'restoredBy'])
        && request.resource.data.isDeleted == false;
    }
    // Target of an in-app notification is management (admin, board, super admin).
    function isStaffUid(uid) {
      let u = get(/databases/$(database)/documents/users/$(uid)).data;
      return u.get('role', '') in ['admin', 'board', 'superadmin']
        || u.get('boardMember', false) == true
        || u.get('superAdmin', false) == true;
    }

    // ---------- users ----------
    match /users/{uid} {
      // Own profile, any staff member, or a board member (needed to broadcast notices)
      allow read: if isOwner(uid) || isStaff() || isBoard();

      // Self-registration: must be your own doc, role 'resident', not pre-approved
      allow create: if isOwner(uid)
        && request.resource.data.role == 'resident'
        && request.resource.data.approved == false;

      // Self-update: cannot escalate role, self-approve/unsuspend, or opt out of recurring bills
      allow update: if (isOwner(uid)
          && request.resource.data.get('role', '') == resource.data.get('role', '')
          && request.resource.data.get('approved', false) == resource.data.get('approved', false)
          && request.resource.data.get('suspended', false) == resource.data.get('suspended', false)
          && request.resource.data.get('billExempt', false) == resource.data.get('billExempt', false))
        || isAdmin() || isSuperAdmin();

      // No hard deletes of user records (soft policy)
      allow delete: if false;

      // In-app notifications: management may notify anyone; residents may only
      // notify management (proof uploaded, new comment, volunteer joined) or themselves.
      // Only the owner reads/updates.
      match /notifications/{noteId} {
        allow read, update, delete: if isOwner(uid);
        allow create: if isStaff() || isBoard() || isOwner(uid) || (signedIn() && isStaffUid(uid));
      }
    }

    // ---------- announcements ----------
    match /announcements/{id} {
      allow read: if signedIn();
      allow create: if canPublish()
        && request.resource.data.get('createdBy', '') == request.auth.uid;
      allow update, delete: if isAdmin() || isSuperAdmin() || ownsPost();

      // Resident comments on an announcement. Approved residents, staff and
      // board members may comment (as themselves); a comment can be removed by
      // its author, admin/superadmin, or the board member who posted the notice.
      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if (isApprovedResident() || isStaff() || isBoard())
          && request.resource.data.get('uid', '') == request.auth.uid
          && request.resource.data.get('text', '') is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && get(/databases/$(database)/documents/announcements/$(id)).data.get('allowComments', true) == true;
        allow update: if false;
        allow delete: if isAdmin() || isSuperAdmin()
          || (signedIn() && resource.data.get('uid', '') == request.auth.uid)
          || (isBoard() && get(/databases/$(database)/documents/announcements/$(id)).data.get('createdBy', '') == request.auth.uid);
      }
    }

    // ---------- polls ----------
    match /polls/{id} {
      allow read: if signedIn();
      allow create: if canPublish()
        && request.resource.data.get('createdBy', '') == request.auth.uid;
      allow delete: if isAdmin() || isSuperAdmin() || ownsPost();
      // Publishers may edit; everyone else may only set or change their own vote while the poll is open.
      allow update: if isAdmin() || isSuperAdmin() || ownsPost()
        || (signedIn()
            && onlyChanges(['votes'])
            && resource.data.get('closed', false) != true
            && request.resource.data.votes.diff(resource.data.get('votes', {})).affectedKeys().hasOnly([request.auth.uid]));
    }

    // ---------- tickets (complaints) ----------
    match /tickets/{id} {
      allow read: if isStaff() || isApprovedResident() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if isApprovedResident() && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin() || superAdminRestore(); // status changes / archive / restore
      allow delete: if false;    // soft delete only
    }

    // ---------- bills ----------
    match /bills/{id} {
      // Residents read only their own bills; society totals come from settings/billsSummary.
      allow read: if isStaff() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if isAdmin();
      // Admin may update anything; the billed resident may only submit payment proof
      allow update: if isAdmin() || superAdminRestore()
        || (signedIn()
            && resource.data.uid == request.auth.uid
            && request.resource.data.status == 'submitted'
            && resource.data.status in ['unpaid', 'submitted']
            && request.resource.data.amount == resource.data.amount
            && request.resource.data.uid == resource.data.uid);
      allow delete: if false; // soft delete only
    }

    // ---------- funds ----------
    match /funds/{id} {
      allow read: if signedIn();
      allow create: if isAdmin();
      allow update: if isAdmin() || superAdminRestore();
      allow delete: if false;
    }

    // ---------- fund contributions ----------
    match /fund_contributions/{id} {
      // Verified contributions are readable by all signed-in users so fund
      // progress totals work; unverified ones only by staff or their owner.
      allow read: if isStaff()
        || (signedIn() && resource.data.uid == request.auth.uid)
        || (signedIn() && resource.data.status == 'verified');
      // Residents and staff submit their own (never pre-verified); admin can record verified cash entries
      allow create: if isAdmin()
        || ((isApprovedResident() || isStaff())
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.status == 'submitted');
      allow update: if isAdmin(); // verify / reject
      allow delete: if false;
    }

    // ---------- expenses ----------
    match /expenses/{id} {
      allow read: if signedIn(); // residents see anonymized category totals in reports
      allow create: if isAdmin();
      allow update: if isAdmin() || superAdminRestore();
      allow delete: if false;
    }

    // ---------- account transfers (Bills account <-> Funds) ----------
    // Immutable ledger entries written by admin only; residents may read them
    // so account balances stay transparent. Undo = an opposite transfer.
    match /transfers/{id} {
      allow read: if signedIn();
      allow create: if isAdmin()
        && request.resource.data.get('fromType', '') in ['bills', 'fund']
        && request.resource.data.get('toType', '') in ['bills', 'fund']
        && (request.resource.data.fromType != request.resource.data.toType
            || request.resource.data.get('fromFundId', '') != request.resource.data.get('toFundId', ''))
        && (request.resource.data.fromType != 'fund' || request.resource.data.get('fromFundId', '') != '')
        && (request.resource.data.toType != 'fund' || request.resource.data.get('toFundId', '') != '')
        && request.resource.data.get('amount', 0) is number
        && request.resource.data.amount > 0
        && request.resource.data.get('note', '') is string
        && request.resource.data.note.size() >= 10;
      allow update, delete: if false;
    }

    // ---------- board decisions & votes ----------
    match /decisions/{id} {
      allow read: if isStaff() || isBoard();
      allow create: if isAdmin();
      // Board members vote: they may only append one vote of their own (and set
      // the outcome when it reaches quorum). Admin may maintain records.
      allow update: if isAdmin()
        || (isBoard()
            && resource.data.get('status', 'pending') == 'pending'
            && onlyChanges(['votes', 'status', 'finalizedAt'])
            && request.resource.data.votes.size() == resource.data.get('votes', []).size() + 1
            && request.resource.data.votes[request.resource.data.votes.size() - 1].uid == request.auth.uid);
      allow delete: if false;
    }

    // ---------- volunteer programs ----------
    match /volunteer_programs/{id} {
      allow read: if signedIn();
      allow create: if isAdmin();
      // Admin manages programs; approved residents join/leave (participants only)
      allow update: if isAdmin() || (isApprovedResident() && onlyChanges(['participants']));
      allow delete: if false;
    }

    // ---------- society settings (bank account etc.) ----------
    match /settings/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    // Bill totals for the resident dashboard, kept up to date by any staff member.
    match /settings/billsSummary {
      allow write: if isStaff();
    }

    // ---------- payment proof files ----------
    // Bills and contributions keep only proofId; the photo or PDF lives here.
    match /proofs/{id} {
      allow read: if isStaff() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if isAdmin() || (signedIn() && request.resource.data.uid == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ---------- audit log (immutable) ----------
    match /audit_log/{id} {
      allow read: if isStaff();
      // Entries are written as yourself.
      allow create: if signedIn() && request.resource.data.get('performedByUid', '') == request.auth.uid;
      allow update, delete: if false;
    }

    // ---------- monthly financial summaries (written by Cloud Functions only) ----------
    match /monthly_summaries/{month} {
      allow read: if signedIn();
      allow write: if false;
    }

    // ---------- report export log ----------
    match /report_exports/{id} {
      allow read: if isStaff();
      allow create: if signedIn();
      allow update, delete: if false;
    }

    // ---------- FCM device tokens ----------
    match /fcm_tokens/{uid} {
      allow read, write: if isOwner(uid) || isAdmin();
    }
  }
}
